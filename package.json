{
  "name": "@donniefi/openclaw-cursor-cli",
  "version": "0.0.9",
  "description": "OpenClaw plugin: route model calls through the local `cursor-agent` binary (Cursor subscription). Maintained fork of @jeehou/openclaw-cursor-cli with Gateway startup/activation and Control UI auth/availability fixes.",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "DonnieFi",
  "homepage": "https://github.com/DonnieFi/openclaw-cursor-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DonnieFi/openclaw-cursor-cli.git"
  },
  "bugs": {
    "url": "https://github.com/DonnieFi/openclaw-cursor-cli/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "cursor",
    "cursor-agent",
    "cli-backend",
    "ai",
    "llm",
    "model-provider"
  ],
  "files": [
    "index.js",
    "setup-api.mjs",
    "openclaw.plugin.json",
    "src/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.0"
    },
    "build": {
      "openclawVersion": "2026.5.7"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "openclaw": "2026.5.7"
  }
}
